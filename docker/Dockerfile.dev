# SOVEREIGN — development image (mounted source, reload)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 SOVEREIGN_MODE=development
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git curl sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN pip install --no-cache-dir -e .

EXPOSE 8000
CMD ["uvicorn", "sovereign.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--app-dir", "src"]
