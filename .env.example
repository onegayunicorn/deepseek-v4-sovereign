# ── SOVEREIGN environment template ─────────────────────────────────────
# Copy to .env and fill. Never commit real secrets.

# Mode: development | staging | production
SOVEREIGN_MODE=development
SOVEREIGN_HOST=0.0.0.0
SOVEREIGN_PORT=8000
LOG_LEVEL=INFO

# ── Model providers ────────────────────────────────────────────────────
# DeepSeek-V4-Flash-0731 via Hugging Face Inference Router (Novita/Together/...)
HF_TOKEN=
HF_ROUTER_URL=https://router.huggingface.co/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731:novita
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── GitHub (scout / enhance / webhooks) ────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=

# ── Persistence ────────────────────────────────────────────────────────
STATE_DB=sqlite:///data/state/orchestration_state.sqlite
VECTOR_BACKEND=chromadb          # chromadb | faiss | memory
VECTOR_PATH=data/memory/vectors
EPISODIC_DB=sqlite:///data/memory/episodic/episodes.db
SEMANTIC_DB=sqlite:///data/memory/semantic/facts.db

# ── Security ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
AES_KEY_B64=                       # 32-byte key, base64 (security/keyring.py)
KEYRING_BACKEND=file              # file | env | vault

# ── Buckets (multi-cloud) ──────────────────────────────────────────────
AWS_PROFILE=accio-data-lake
GCP_PROJECT_ID=accio-cloud-platform
AZURE_CONNECTION_STRING=

# ── Hardware ───────────────────────────────────────────────────────────
BCI_RING_PORT=/dev/ttyUSB0        # or BLE address
BUD_DEVICE_ID=                    # muse / sovereign-buds BLE MAC
SENSOR_RATE_HZ=500

# ── Distribution ───────────────────────────────────────────────────────
RELEASE_VERSION=0.1.0
RELEASE_CHANNELS=github-releases,huggingface-spaces
